    <div class="page-banner banner-lg contact-banner" style="background-image:url(images/banner/img1.jpg);">
        <div class="container">
            <div class="page-banner-entry text-center">
                <!--<br /><br /><br /><br /><br />-->
                <h1 style="font-size:45px">Advanced Medical Directive Form</h1>
                <!--<br /><br /><br />-->
                <!-- Breadcrumb row -->
                <!--<nav aria-label="breadcrumb" class="breadcrumb-row">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item active"><a href="amdinfo.html">Your Details</a></li>
                        <li class="breadcrumb-item" aria-current="page"><a href="index.html"><div style="color: coral; font-weight: 700">Witness</div></a></li>
                        <li class="breadcrumb-item" aria-current="page"><a href="amdview.html">View Details</a></li>
                        <li class="breadcrumb-item" aria-current="page"><a href="index.html">Payment</a></li>
                        <li class="breadcrumb-item" aria-current="page"><a href="amdpdf.html">Download</a></li>
                    </ul>
                </nav>-->
            </div>
        </div>
        <img class="pt-img1 animate-wave" src="images/shap/wave-blue.png" alt="">
        <img class="pt-img2 animate2" src="images/shap/circle-dots.png" alt="">
        <img class="pt-img3 animate-rotate" src="images/shap/plus-blue.png" alt="">
    </div>

    <!-- Breadcrumb row END -->
</div>

<!-- Inner Banner end -->
<!-- About us -->
<section class="">
    <div class="container" style="width:70%">
        <div class="contact-wraper">
            <div class="row ">
                <div class="col-lg-12 mb-30">
                    <form class="form-wraper contact-form " method="post">
                        <div class="ajax-message">
                            <div class="stepper-wrapper">
                                <div class="stepper-item completed">
                                    <div class="step-counter">1</div>
                                    <div class="step-name">Your Info</div>
                                </div>
                                <div class="stepper-item active">
                                    <div class="step-counter">2</div>
                                    <div class="step-name">Witness<br></div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">3</div>
                                    <div class="step-name">View Details</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">4</div>
                                    <div class="step-name">Payment<br></div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">5</div>
                                    <div class="step-name">Download</div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div class="col-lg-12 mb-30">
                        <form class="form-wraper contact-form" method="post" id="theForm">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <div class="row">
                                <h3 style="text-align: center; padding-bottom: 20px;">Witness Details</h3>

                                <div class="form-group col-md-6">
                                    <input asp-for="amd.name" name="name" type="text" required class="form-control" placeholder="Name">
                                    
                                </div>
                                <div class="form-group col-md-6">
                                    <input asp-for="amd.nric" name="nric" type="text" required class="form-control" placeholder="NRIC">
                                   
                                </div>
                                <div class="form-group col-md-8">
                                    <input asp-for="amd.address" name="address" type="text" required class="form-control" placeholder="Address">
                                  
                                </div>
                                <div class="form-group col-md-4">
                                    <input asp-for="amd.postal" name="postal" type="text" required class="form-control" placeholder="Postal Code">
                                   
                                </div>
                                <div class="form-group col-md-6">
                                    <input asp-for="amd.homeno" name="homeno" type="text" required class="form-control" placeholder="Home Number">
                                   
                                </div>
                                <div class="form-group col-md-6">
                                    <input asp-for="amd.officeno" name="officeno" type="text" required class="form-control" placeholder="Office Number">
                                   
                                </div>
                                <div class="text-center">
                                    <button class="btn btn-secondary" style="padding-left:80px; padding-right:80px; font-size:15px" onclick="submitThis()">Next</button>
                                    @*<input id="create" type="submit" value="Create" class="btn btn-primary" />*@
                                    
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        </div>
</section>

<br />
<br />
<br />
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

<script>
    function submitThis() {
        document.getElementById("theForm").submit();
    }
</script>
}