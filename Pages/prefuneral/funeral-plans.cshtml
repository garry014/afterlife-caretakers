@page
@model afterlife_caretakers.Pages.prefuneral.funeral_plansModel
@{
    ViewData["Title"] = "Funeral Plans - Wake/Funeral Planning";
}

<style type="text/css">
    /* HIDE RADIO */
    [type=radio] {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

        /* IMAGE STYLES */
        [type=radio] + img {
            cursor: pointer;
        }

        /* CHECKED STYLES */
        [type=radio]:checked + img {
            outline: 5px solid #f4925a;
        }

    input[type=checkbox] {
        transform: scale(1.5);
    }

    .checkboxes label {
        font-size: 17px;
    }

    .textImgContainer {
        position: relative;
        max-width: 800px;
        margin: 0 auto;
    }

        .textImgContainer img {
            vertical-align: middle;
        }

        .textImgContainer .content {
            position: absolute;
            bottom: 0;
            background: rgb(0, 0, 0); /* Fallback color */
            background: rgba(0, 0, 0, 0.5); /* Black background with 0.5 opacity */
            color: #f1f1f1;
            width: 100%;
            padding-left: 20px;
            padding-right: 20px;
            text-align: center;
            font-size: 18px;
        }
</style>

<!-- Inner Banner -->
<div class="banner-wraper">
    <div class="page-banner banner-lg contact-banner" style="background-image:url(/images/banner/img1.jpg);">
        <div class="container">
            <div class="page-banner-entry text-center">
                <h1>Pre-Funeral Planning</h1>
                <!-- Breadcrumb row -->
                <nav aria-label="breadcrumb" class="breadcrumb-row">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="index.html"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg> Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Pre-Funeral Planning</li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
    <!-- Breadcrumb row END -->
</div>
<!-- Inner Banner end -->
<!-- About us -->
<section class="">
    <div class="container">
        <div class="contact-wraper">

            <div class="col-lg-12 mb-30">
                <form class="form-wraper contact-form" method="post">
                    <div class="stepper-wrapper">
                        <div class="stepper-item completed">
                            <div class="step-counter">1</div>
                            <div class="step-name"><a href="./religion?id=@Model.Funeral.Id">Religion</a></div>
                        </div>
                        <div class="stepper-item completed">
                            <div class="step-counter">2</div>
                            <div class="step-name"><a href="./wake-location?id=@Model.Funeral.Id">Wake <br>Location</a></div>
                        </div>
                        <div class="stepper-item completed">
                            <div class="step-counter">3</div>
                            <div class="step-name"><a href="./wake-plans?id=@Model.Funeral.Id">Wake <br>Plans</a></div>
                        </div>
                        <div class="stepper-item completed">
                            <div class="step-counter">4</div>
                            <div class="step-name"><a href="./wake-addons?id=@Model.Funeral.Id">Wake <br>Add-ons</a></div>
                        </div>
                        <div class="stepper-item active">
                            <div class="step-counter">5</div>
                            <div class="step-name">Funeral <br>Plans</div>
                        </div>
                        <div class="stepper-item">
                            <div class="step-counter">6</div>
                            <div class="step-name">Final Resting<br>Place</div>
                        </div>
                        <div class="stepper-item">
                            <div class="step-counter">7</div>
                            <div class="step-name">Plan<br>Executor(s)</div>
                        </div>
                        <div class="stepper-item">
                            <div class="step-counter">8</div>
                            <div class="step-name">Confirmation<br>& Payment</div>
                        </div>
                    </div>
                    <div style="display:none;">
                        <input type="hidden" asp-for="Funeral.Id" />
                        <input type="hidden" asp-for="Funeral.TimeStamp">
                        <input type="text" asp-for="Funeral.Religion" />
                        <input type="text" asp-for="Funeral.WakeLocationIn">
                        <input type="text" asp-for="Funeral.WakePostalCode">
                        <input type="text" asp-for="Funeral.LocationAttire">
                        <input type="text" asp-for="Funeral.FinalRestingPlace">
                        <input type="text" asp-for="Funeral.ColumbariumName">
                        <input type="text" asp-for="Funeral.PlaqueName">
                        <input type="text" asp-for="Funeral.CasketID">
                    </div>
                    <h5><u>What is a Funeral?</u></h5>
                    A funeral is a ceremony connected with the final disposition of a corpse, such as a burial or cremation.<br><br>
                    <h5>Funeral Transportation Vehicle (driver inclusive):*</h5>
                    *Required to fill in or select.<br><br>
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label>
                                <div class="textImgContainer">
                                    @Html.RadioButton("Funeral.FuneralVechicle", "van hearse")
                                    <img src="/images/funeral/van-hearse.png">
                                    <div class="content">Van Hearse (+$@Model.fp.VanHearse)</div>
                                </div>
                            </label>
                        </div>
                        <div class="form-group col-md-4">
                            <label>
                                <div class="textImgContainer">
                                    @Html.RadioButton("Funeral.FuneralVechicle", "limousine hearse")
                                    <img src="/images/funeral/limousine-hearse.png">
                                    <div class="content">Limousine Hearse (+$@Model.fp.LimousineHearse)</div>
                                </div>
                            </label>
                        </div>
                        <div class="form-group col-md-4">
                            <label>
                                <div class="textImgContainer">
                                    @Html.RadioButton("Funeral.FuneralVechicle", "float hearse")
                                    <img src="/images/funeral/float-hearse.png">
                                    <div class="content">Float Hearse (+$@Model.fp.FloatHearse)</div>
                                </div>
                            </label>
                        </div>
                        <span asp-validation-for="Funeral.FuneralVechicle" class="text-danger"></span>
                        <div class="form-group col-md-12" id="showRites">
                            <h5>Funeral Plan</h5>
                            These services are <span style="font-weight:bold">OPTIONAL</span>. Check the boxes next to it if ONLY you <span style="font-weight:bold">require</span> the service.
                        </div>
                        <div class="form-group col-md-12" id="riteSettings">
                            <input type="checkbox" asp-for="Funeral.HasFuneralCermony">
                            <label asp-for="Funeral.HasFuneralCermony" style="font-size: medium; display: inline"> <span style="color:#565ace">[RECOMMENDED]</span> Funeral Ceremony & Public Viewing (+$@Model.fp.FuneralCeremony)</label><br>
                            <input type="checkbox" asp-for="Funeral.HasBusCatering">
                            <label asp-for="Funeral.HasBusCatering" style="font-size: medium; display: inline"> <span style="color:#565ace">[RECOMMENDED]</span> Bus for visitors (+$@Model.fp.BusForVisitors)</label><br>
                            <input type="checkbox" asp-for="Funeral.HasMemorialService">
                            <label asp-for="Funeral.HasMemorialService" style="font-size: medium; display: inline"> Memorial Service (+$@Model.fp.MemorialService)</label>
                        </div>
                        <div class="form-group col-md-4">
                            <span style="font-weight:bold">Guests expected on the day*:</span>
                        </div>
                        <div class="form-group col-md-4">
                            <select class="form-select" asp-for="Funeral.FGuestsExpected">
                                <option selected></option>
                                <option value="1">0-50</option>
                                <option value="2">51-100</option>
                                <option value="3">100-200</option>
                                <option value="4">>200</option>
                            </select>
                            <span asp-validation-for="Funeral.FGuestsExpected" class="text-danger"></span>
                        </div>
                        <div class="col-lg-4">
                            <!-- Intentionally left blank -->
                        </div>

                        <div class="col-lg-6">
                            <!-- Intentionally left blank -->
                        </div>

                        <div class="form-group col-md-3">
                            <button name="back" type="back" value="Back" class="btn w-100 btn-secondary btn-lg" style="background-color: #e0ded7; color: black" onclick="location.href = './wake-addons?id=@Model.Funeral.Id';">Previous</button>
                        </div>
                        <div class="col-lg-3">
                            <button name="submit" type="submit" value="Submit" class="btn w-100 btn-secondary btn-lg">Save & Next</button>
                        </div>
                        <div class="form-group col-md-12" style="text-align:right;">
                            <sup>Pricing reflected is only valid for today's payment. Prices are subjected to changes for future payment.</sup>
                        </div>
                    </div>
                </form>
            </div>


        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}