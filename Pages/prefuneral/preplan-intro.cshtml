@page
@model afterlife_caretakers.Pages.prefuneral.preplan_introModel
@{
    ViewData["Title"] = "Pre-funeral Planning Introduction";
}

<!-- Main Banner -->
<div class="main-banner" style="background-image:url(/images/main-banner/bg1.jpg);">
    <div class="container inner-content">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12">
                <h1 style="margin: 0;">Your wake, your way, customise ahead.</h1>
                <h6 style="color:#565acf">Starting from $2,000.</h6>
                <a asp-page="/prefuneral/start-planning" class="btn btn-secondary btn-lg shadow">Start Planning</a><br>
                Payment now or later, it’s your choice.<br>
                30 days full-refund guaranteed, <br>
                no questions asked.
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="banner-img">
                    <iframe width="560" height="315" src="https://www.youtube.com/embed/tda_mLCDeXg"
                            title="YouTube video player" frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>