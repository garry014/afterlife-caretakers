@page
@model afterlife_caretakers.Pages.prefuneral.viewplansModel
@{
    ViewData["Title"] = "View Plans - Wake/Funeral Planning";
}

<style>
    @@media (min-width:1000px) {
        #dynamicParent {
            padding-left: 20%;
            padding-right: 20%;
        }
    }

    .caps {
        text-transform: capitalize;
    }
</style>

<!-- Inner Banner -->
<div class="banner-wraper">
    <div class="page-banner banner-lg contact-banner" style="background-image:url(/images/banner/img1.jpg);">
        <div class="container">
            <div class="page-banner-entry text-center">
                <h1>Pre-Funeral Planning</h1>
                <!-- Breadcrumb row -->
                <nav aria-label="breadcrumb" class="breadcrumb-row">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="index.html"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg> Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Pre-Funeral Planning</li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
    <!-- Breadcrumb row END -->
</div>
<!-- Inner Banner end -->
<!-- About us -->
<section class="">
    <div class="container">
        <div class="contact-wraper">
            <div class="row">
                <div class="col-lg-12 mb-30">
                    <form class="form-wraper contact-form" method="post">
                        <center><h5><u>Review and Confirm</u></h5></center>
                        <div class="row" id="dynamicParent">
                            <h6>Religion</h6>
                            <div class="col-6"><span>Religion:</span></div>
                            <div class="col-6"><span class="caps">@Model.Funeral.Religion</span></div>
                            @if (@Model.Funeral.RequireRites == true)
                            {
                                <div class="col-6"><span>Require Rites:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                                @if (@Model.Funeral.ConductOptions == "planout")
                                {
                                    <div class="col-6"><span>How my rite is conducted:</span></div>
                                    <div class="col-6"><span>All planned out by ALC.</span></div>
                                }
                                else
                                {
                                    <div class="col-6"><span>How my rite is conducted:</span></div>
                                    <div class="col-6"><span>Contact the following personnel/organisation.</span></div>
                                    <div class="col-6"><span>Religious Place Name:</span></div>
                                    <div class="col-6"><span>@Model.Funeral.ReligiousPName</span></div>
                                    <div class="col-6"><span>Point of Contact Name:</span></div>
                                    <div class="col-6"><span>@Model.Funeral.ReligiousPOCName</span></div>
                                    <div class="col-6"><span>Point of Contact Number:</span></div>
                                    <div class="col-6"><span>@Model.Funeral.ReligiousPOCNumber</span></div>
                                }
                            }
                            else
                            {
                                <div class="col-6"><span>Require Rites:</span></div>
                                <div class="col-6"><span>No</span></div>
                            }

                            <br /><hr />
                            <h6>Wake Location</h6>
                            <div class="col-6"><span>Location Type:</span></div>
                            <div class="col-6"><span>@Model.Funeral.WakeLocationIn</span></div>
                            <div class="col-6"><span>Postal Code:</span></div>
                            <div class="col-6"><span>@Model.Funeral.WakePostalCode</span></div>

                            <br /><hr />
                            <h6>Wake Plans</h6>
                            <div class="col-6"><span>Casket Chosen:</span></div>
                            <div class="col-6">
                                @{ if (Model.allcaskets != null)
                                    {
                                        @foreach (var item in Model.allcaskets)
                                        {
                                            if (item.Id == Model.Funeral.CasketID)
                                            {
                                                <img src="/images/funeral/catalouge/@item.ImageLink">
                                            }
                                        }
                                    }
                                }
                            </div>
                            <div class="col-6"><span>Duration:</span></div>
                            <div class="col-6"><span>@Model.Funeral.WakeDuration days</span></div>
                            <div class="col-6"><span>Photo Framed:</span></div>
                            <div class="col-6"><img src="/images/uploads/funeral_photoFramed/@Model.Funeral.PhotoFramed"></div>
                            <div class="col-6"><span>Photo Attrie:</span></div>
                            <div class="col-6"><img src="/images/uploads/funeral_photoAttire/@Model.Funeral.PhotoAttire" height="100px" width="auto"></div>
                            <div class="col-6"><span>Location of Attire:</span></div>
                            <div class="col-6"><span>@Model.Funeral.LocationAttire</span></div>
                            <div class="col-6"><span>Number of Guests Expected:</span></div>
                            <div class="col-6"><span>@Model.Funeral.WakeGuestsExpected</span></div>

                            <br /><hr />
                            <h6>Wake Add-ons</h6>
                            @if (@Model.Funeral.HasMakeupServices == true)
                            {
                                <div class="col-6"><span>Make-up Services:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            @if (@Model.Funeral.HasHairstylingServices == true)
                            {
                                <div class="col-6"><span>Hairstyling Services:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            @if (@Model.Funeral.HasMobileToilet == true)
                            {
                                <div class="col-6"><span>Mobile Toilet:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            @if (@Model.Funeral.HasBeverages == true)
                            {
                                <div class="col-6"><span>Beverages:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            @if (@Model.Funeral.HasTibits == true)
                            {
                                <div class="col-6"><span>Tibits: </span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            @if (@Model.Funeral.HasFridge == true)
                            {
                                <div class="col-6"><span>Fridge:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }

                            @if (@Model.Funeral.HasLunch == true)
                            {
                                <br /><span style="font-weight:bold;">Catering</span>
                                <div class="col-6"><span>Lunch:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            @if (@Model.Funeral.HasDinner == true)
                            {
                                <div class="col-6"><span>Dinner:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            @if (@Model.Funeral.HasRegisterBook == true)
                            {
                                <div class="col-6"><span>Register Book:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            @if (@Model.Funeral.HasMemorialFolders == true)
                            {
                                <div class="col-6"><span>Memorial Folders:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }

                            <br /><hr />
                            <h6>Funeral Plans</h6>
                            <div class="col-6"><span>Funeral Transportation Vehicle:</span></div>
                            <div class="col-6"><span>@Model.Funeral.FuneralVechicle</span></div>
                            @if (@Model.Funeral.HasFuneralCermony == true)
                            {
                                <div class="col-6"><span>Funeral Ceremony & Public Viewing:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            @if (@Model.Funeral.HasBusCatering == true)
                            {
                                <div class="col-6"><span>Funeral Ceremony & Public Viewing:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            @if (@Model.Funeral.HasBusCatering == true)
                            {
                                <div class="col-6"><span>Funeral Ceremony & Public Viewing:</span></div>
                                <div class="col-6"><span>Yes</span></div>
                            }
                            <div class="col-6"><span>Funeral Guests Expected:</span></div>
                            <div class="col-6"><span>@Model.Funeral.FGuestsExpected</span></div>

                            <br /><hr />
                            <h6>Resting Place</h6>
                            <div class="col-6"><span>Final Resting Place:</span></div>
                            <div class="col-6"><span>@Model.Funeral.FinalRestingPlace</span></div>

                            @if (@Model.Funeral.FinalRestingPlace == "Religious Institution Columbarium")
                            {
                                <div class="col-6"><span>Columbarium:</span></div>
                                <div class="col-6"><span>@Model.Funeral.ColumbariumName</span></div>
                            }

                            @if (@Model.Funeral.FinalRestingPlace == "Religious Institution Columbarium" || @Model.Funeral.FinalRestingPlace == "Government Columbarium" || @Model.Funeral.FinalRestingPlace == "Chua Chao Kang Cemetery")
                            {
                                <br /><span style="font-weight:bold;">Plaque Printing</span>
                                <div class="col-6"><span>Name to be Printed:</span></div>
                                <div class="col-6"><span>@Model.Funeral.PlaqueName</span></div>
                                <div class="col-6"><span>Scriptures/Quotes:</span></div>
                                <div class="col-6"><span>@Model.Funeral.PlaqueQuotes</span></div>
                                <div class="col-6"><span>Urn Design:</span></div>
                                <div class="col-6">
                                    @{ if (Model.allcaskets != null)
                                        {
                                            @foreach (var item in Model.allcaskets)
                                            {
                                                if (item.Id == @Model.Funeral.UrnId)
                                                {
                                                    <img src="/images/funeral/catalouge/@item.ImageLink">
                                                }
                                            }
                                        }
                                    }
                                </div>
                            }
                            <br /><hr />
                            <h5><u>Proceed to Payment</u></h5>
                            <div id="smart-button-container" style="border:3px solid black; padding: 0 10% 0 10%">
                                <span style="font-weight: bold;"><center>Pay today and Pay: <u>$@Model.totalSum</u></center></span>
                                <div style="text-align: center;">
                                    <div id="paypal-button-container"></div>
                                </div>
                            </div>
                            <script><script src="https://www.paypal.com/sdk/js?client-id=YOUR_CLIENT_ID"> // Replace YOUR_CLIENT_ID with your sandbox client ID</script>


                            <div id="paypal-button-container"></div>

                            <!-- Add the checkout buttons, set up the order and approve the order -->
                            <script src="https://www.paypal.com/sdk/js?client-id=sb&currency=SGD"
                                    data-sdk-integration-source="button-factory"></script>

                            <br>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function initPayPalButton() {

            paypal.Buttons({
                style: {
                    shape: 'rect',
                    color: 'gold',
                    layout: 'vertical',
                    label: 'checkout',

                },

                createOrder: function (data, actions) {
                    return actions.order.create({
                        purchase_units: [{ "amount": { "currency_code": "SGD", "value": 2400 } }]
                    });
                },

                onApprove: function (data, actions) {
                    return actions.order.capture().then(function (details) {
                        window.location.replace("/funeralplan-complete.html");
                    });
                },

                onError: function (err) {
                    console.log(err);

                }
            }).render('#paypal-button-container');
                                                            }
        initPayPalButton();
    </script>
}