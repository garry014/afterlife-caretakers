@page
@model afterlife_caretakers.Pages.prefuneral.start_planningModel
@{
    ViewData["Title"] = "Start Planning - Wake/Funeral Planning";
}
<!-- Inner Banner -->
<div class="banner-wraper">
    <div class="page-banner banner-lg contact-banner" style="background-image:url(/images/banner/img1.jpg);">
        <div class="container">
            <div class="page-banner-entry text-center">
                <h1>Pre-Funeral Planning</h1>
                <!-- Breadcrumb row -->
                <nav aria-label="breadcrumb" class="breadcrumb-row">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="index.html"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg> Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Pre-Funeral Planning</li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
    <!-- Breadcrumb row END -->
</div>
<!-- Inner Banner end -->
<!-- About us -->
<section class="">
    <div class="container">
        <div class="contact-wraper">
            <div class="row">
                <div class="col-lg-12 mb-30">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-6 col-sm-12">
                                <div class="team-member mb-30">
                                    <div class="team-info">
                                        <div class="team-info-comntent">
                                            <h4 class="title">Customise from scratch</h4>
                                            <span class="text-secondary">If you prefer to be in full-control and DIY your plan, then this option is for you!</span>
                                        </div>
                                        <form method="post">
                                            <br><button type="submit" class="btn btn-outline-primary btn-sm">START FROM SCRATCH<i class="btn-icon-bx fas fa-chevron-right"></i></button>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6 col-sm-12">
                                <div class="team-member mb-30">
                                    <div class="team-info">
                                        <div class="team-info-comntent">
                                            <h4 class="title">Pick a package and modify</h4>
                                            <span class="text-secondary">A well picked package by our advisors, which is specially picked to ensure the essentials is well brought to you!</span>
                                        </div>
                                        <a asp-page="/prefuneral/funeral-packages" class="btn btn-outline-primary btn-sm">MODIFY FROM A PACKAGE<i class="btn-icon-bx fas fa-chevron-right"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>