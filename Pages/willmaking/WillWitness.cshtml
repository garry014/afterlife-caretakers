@page
@model afterlife_caretakers.Pages.willmaking.WillWitnessModel
@{
    ViewData["Title"] = "Create/Find Witness";
}

<!-- Inner Banner -->
<div class="banner-wraper">
    <div class="page-banner banner-lg contact-banner" style="background-image:url(images/banner/img1.jpg);">
        <div class="container">
            <div class="page-banner-entry text-center">
                <h1>Will Creation</h1>
                <!-- Breadcrumb row -->
                <nav aria-label="breadcrumb" class="breadcrumb-row">
                    @*<ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="index.html"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg> Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Contact Us</li>
                        </ul>*@
                </nav>
            </div>
        </div>
        <img class="pt-img1 animate-wave" src="images/shap/wave-blue.png" alt="">
        <img class="pt-img2 animate2" src="images/shap/circle-dots.png" alt="">
        <img class="pt-img3 animate-rotate" src="images/shap/plus-blue.png" alt="">
    </div>
    <!-- Breadcrumb row END -->
</div>
<!-- Inner Banner end -->
<section class="">
    <div class="container">
        <div class="contact-wraper">
            <div class="row">
                <div class="row">
                    <div class="col-lg-12 mb-30">
                        <form class="form-wraper contact-form ajax-form" action="script/contact.php">
                            <div class="stepper-wrapper">
                                <div class="stepper-item completed">
                                    <div class="step-counter">1</div>
                                    <div class="step-name">Your Info</div>
                                </div>
                                <div class="stepper-item completed">
                                    <div class="step-counter">2</div>
                                    <div class="step-name">Distribution of Assets<br></div>
                                </div>
                                <div class="stepper-item completed">
                                    <div class="step-counter">3</div>
                                    <div class="step-name">Executor</div>
                                </div>
                                <div class="stepper-item active">
                                    <div class="step-counter">4</div>
                                    <div class="step-name">Witness</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">5</div>
                                    <div class="step-name">Payment</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">6</div>
                                    <div class="step-name">Download PDF</div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-lg-6 mb-30">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <table class="table table-bordered" id="editableTable">
                        <thead>
                            <tr>
                                <th>Witness Name</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ if (Model.ownerWitnessList != null)
                                {

                                    @foreach (var item in Model.ownerWitnessList)
                                    {
                                        <tr>
                                            <td>@item.NAME</td>

                                            <td><a asp-page="/willmaking/EditWitness" asp-route-id="@item.Id"> <i class="fas fa-edit"></i> Edit</a>
                                            <a asp-page="/willmaking/DeleteWitness" asp-route-id="@item.Id"><i class="fa fa-trash" aria-hidden="true"></i> Delete</a></td>
                                        </tr>

                                    }
                                }
                            }
                        </tbody>
                    </table>
                    <br />
                    <form class="form-wraper contact-form" method="post">
                        <div class="row">
                            <div class="form-group col-md-8">
                                <label for="Witness">Do you have anybody to be your witness?(if yes, please fill in their particulars)</label>
                                <br>
                                <div class="form-group col-md-8">
                                    <p>
                                        <label>
                                            <input class="myradio" type="radio" name="default"
                                                   onclick="setWitness(true)"> Yes
                                        </label>
                                        <br>
                                        <label>
                                            <input class="myradio" type="radio" name="default" value="0"
                                                   onclick="setWitness(false)"> No
                                        </label>

                                    </p>
                                </div>
                            </div>
                            <div id="wDetails" style="display:none">
                                <div class="form-group col-md-8" style="margin:8px;">
                                    @*<input type="hidden" value="@WillWitnessModel.Id" name="Id" />*@
                                    <label>What is the witness relationship to you: eg.Friend/Mother/Father</label>
                                    <input asp-for="MyWitness.Relationship" type="text" required class="form-control"
                                           placeholder="Relationship to Will Maker">
                                    <span asp-validation-for="MyWitness.Relationship" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-8" style="margin:8px;">
                                    <label>What is the witness FullName?</label>
                                    <input asp-for="MyWitness.NAME" type="text" class="form-control"
                                           placeholder="FullName">
                                    <span asp-validation-for="MyWitness.NAME" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-8" style="margin:8px;">
                                    <label>What is the witness NRIC:</label>
                                    <input asp-for="MyWitness.NRIC" type="text" class="form-control"
                                           placeholder="NRIC">
                                    <span asp-validation-for="MyWitness.NRIC" class="text-danger"></span>
                                </div>
                                <!-- Calendar -->
                                <div class="form-group col-md-8" style="margin:8px;">
                                    <label>What is the witness age:</label>
                                    <input asp-for="MyWitness.BirthDate" type="date" class="form-control"
                                           placeholder="BirthDate">
                                    <span asp-validation-for="MyWitness.BirthDate" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-8" style="margin:8px;">
                                    <label>What is the witness phone number:</label>
                                    <input asp-for="MyWitness.PhoneNo" type="text" class="form-control"
                                           placeholder="Phone Number">
                                    <span asp-validation-for="MyWitness.PhoneNo" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-8" style="margin:8px;">
                                    <label>What is the witness email:</label>
                                    <input asp-for="MyWitness.Email" type="text" class="form-control"
                                           placeholder="Email eg. patrick@yahoo.com">
                                    <span asp-validation-for="MyWitness.Email" class="text-danger"></span>
                                </div>
                                <br>
                                <!-- Adding another beneficiary -->
                                <div class="form-group col-md-8" style="margin:8px;">
                                    <p class="form-submit">
                                        <button asp-page-handler="AddWitness" class="blueButton" id="addBeneficiaryBtn">
                                            Add
                                            Witness
                                        </button>
                                    </p>
                                    <br>
                                    <br>
                                </div>
                            </div>
                            <div id="wNDetails" style="display:none;" class="form-group col-md-8">
                                <label>Click on the button to find the witness of your choice.</label>
                                <p class="form-submit">
                                    <button class="blueButton" id="addBeneficiaryBtn"
                                            onclick="">
                                        Find Witness
                                    </button>
                                </p>
                                <br>
                                <br>
                            </div>
                            <div class="row">
                                <div class="col-lg-6">
                                    @*<button asp-page-handler="WitnessBack" name="submit" type="submit" value="Back" class="BButton w-100 btn-lg" style="height:60px;">Back</button>*@
                                    <button type="button" value="Back" onclick="location.href = 'WillExecutor';" class="BButton w-100 btn-lg" style="height:60px;">Back</button>
                                </div>
                                <br>
                                <div class="col-sm-6">
                                    <button asp-page-handler="WitnessNext" name="submit" type="submit" value="Next" class="btn w-100 btn-secondary btn-lg">Save & Next</button>
                                </div>
                            </div>
                        </div>
                        <br>
                    </form>
                </div>
                <!-- Right hand side part of the website -->
                <div class="col-lg-6 mb-30">
                    <div class="contact-info ovpr-dark" style="background-image: url(images/about/pic-1.jpg);">
                        <div class="info-inner">
                            <h4 class="title mb-30">Witness</h4>
                            <text>
                                Witnesses are people who will sign the will in the will-maker's
                                presence. There are two types of witnesses on our website.
                            </text>
                            <br>
                            <text>Your Own Witness Or the Witness that you have sourced from our website.</text>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}