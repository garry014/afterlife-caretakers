@page
@using afterlife_caretakers.Models;
@model afterlife_caretakers.Pages.willmaking.WillFormModel
@{
    ViewData["Title"] = "Create Will";
}
<!-- Inner Banner -->
<div class="banner-wraper">
    <div class="page-banner banner-lg contact-banner" style="background-image:url(images/banner/img1.jpg);">
        <div class="container">
            <div class="page-banner-entry text-center">
                <h1>Will Creation</h1>
                <!-- Breadcrumb row -->
                <nav aria-label="breadcrumb" class="breadcrumb-row">
                    @*<ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="index.html"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg> Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Contact Us</li>
                        </ul>*@
                </nav>
            </div>
        </div>
        <img class="pt-img1 animate-wave" src="images/shap/wave-blue.png" alt="">
        <img class="pt-img2 animate2" src="images/shap/circle-dots.png" alt="">
        <img class="pt-img3 animate-rotate" src="images/shap/plus-blue.png" alt="">
    </div>
    <!-- Breadcrumb row END -->
</div>
<!-- Inner Banner end -->
<section class="">
    <div class="container">
        <div class="contact-wraper">
            <div class="row">
                <div class="row">
                    <div class="col-lg-12 mb-30">
                        <div class="form-wraper contact-form ajax-form" action="script/contact.php">
                            <div class="stepper-wrapper">
                                <div class="stepper-item active">
                                    <div class="step-counter">1</div>
                                    <div class="step-name">Your Info<br>Personal Information</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">2</div>
                                    <div class="step-name">Distribution of Assets<br></div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">3</div>
                                    <div class="step-name">Executor</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">4</div>
                                    <div class="step-name">Witness<br></div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">5</div>
                                    <div class="step-name">Payment</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">6</div>
                                    <div class="step-name">Download PDF<br></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 mb-30">
                    <form class="form-wraper contact-form" id="myForm" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="row">
                            <input hidden asp-for="MyUser.Id" />
                            <input hidden asp-for="MyUser.password" />
                            <div class="form-group col-md-8">
                                <label>What is your Full name?</label>
                                <input type="text" asp-for="MyUser.name" class="form-control">
                                <span asp-validation-for="MyUser.name" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="row">
                            <div class="form-group col-md-8">
                                <label>What is your Gender?</label>
                                <br />
                                @Html.RadioButton("MyUser.gender", "M")<span>M</span>
                                <br />
                                @Html.RadioButton("MyUser.gender", "F")<span>F</span>
                                <span asp-validation-for="MyUser.gender" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-8">
                                <label>What is your NRIC?</label>
                                <input asp-for="MyUser.NRIC" type="text" class="form-control">
                                <span asp-validation-for="MyUser.NRIC" class="text-danger"></span>
                            </div>

                        </div>
                        <div class="row">
                            <div class="form-group col-md-8">
                                <label>What is your Mobile Number?</label>
                                <input type="text" asp-for="MyUser.email" class="form-control">
                                <span asp-validation-for="MyUser.email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-8">
                                <label>What is your Mobile Number?</label>
                                <input type="text" asp-for="MyUser.phoneno" class="form-control">
                                <span asp-validation-for="MyUser.phoneno" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-8">
                                <label>What is your home address?</label>
                                <input type="text" asp-for="MyUser.address" class="form-control">
                                <span asp-validation-for="MyUser.address" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <button type="button" value="Back" onclick="location.href = 'WillManual';" class="BButton w-100 btn-lg" style="height:60px;">Back</button>
                            </div>
                            <br>
                            <div class="col-sm-6">
                                <button asp-page-handler="FirstNext" name="submit" type="submit" onclick="document.getElementById('myForm').submit()" class="btn w-100 btn-secondary btn-lg">Save & Next</button>
                            </div>
                        </div>
                        <input type="hidden" asp-for="MyUser.usertype" />
                        <input type="hidden" asp-for="MyUser.NRIC_upload" />
                        <input type="hidden" asp-for="MyUser.activation_status" />
                        <input type="hidden" asp-for="MyUser.deathcert_upload" />
                        <input type="hidden" asp-for="MyUser.deathdate_setting" />
                    </form>


                </div>

                <!-- Right hand side part of the website -->
                <div class="col-lg-6 mb-30">
                    <div class="contact-info ovpr-dark" style="background-image: url(images/about/pic-1.jpg);">
                        <div class="info-inner">
                            <!-- some text here -->
                            <text>Your Personal Information has to be in the Will</text>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
