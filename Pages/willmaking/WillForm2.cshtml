@page
@model afterlife_caretakers.Pages.willmaking.WillForm2Model
@{
    ViewData["Title"] = "Create Will 2";
}
<!-- Inner Banner -->
<div class="banner-wraper">
    <div class="page-banner banner-lg contact-banner" style="background-image:url(images/banner/img1.jpg);">
        <div class="container">
            <div class="page-banner-entry text-center">
                <h1>Will Creation</h1>
                <!-- Breadcrumb row -->
                <nav aria-label="breadcrumb" class="breadcrumb-row">
                    @*<ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="index.html"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg> Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Contact Us</li>
                        </ul>*@
                </nav>
            </div>
        </div>
        <img class="pt-img1 animate-wave" src="images/shap/wave-blue.png" alt="">
        <img class="pt-img2 animate2" src="images/shap/circle-dots.png" alt="">
        <img class="pt-img3 animate-rotate" src="images/shap/plus-blue.png" alt="">
    </div>
    <!-- Breadcrumb row END -->
</div>
<!-- Inner Banner end -->
<section class="">
    <div class="container">
        <div class="contact-wraper">
            <div class="row">
                <div class="row">
                    <div class="col-lg-12 mb-30">
                        <form class="form-wraper contact-form ajax-form" action="script/contact.php">
                            <div class="stepper-wrapper">
                                <div class="stepper-item active">
                                    <div class="step-counter">1</div>
                                    <div class="step-name">Your Info<br>Marital Status</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">2</div>
                                    <div class="step-name">Distribution of Assets<br></div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">3</div>
                                    <div class="step-name">Executor</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">4</div>
                                    <div class="step-name">Witness</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">5</div>
                                    <div class="step-name">Payment</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">6</div>
                                    <div class="step-name">Download PDF</div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-lg-6 mb-30">
                    <form class="form-wraper contact-form" id="myForm" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        @*<div class="row" id="MaritalForm">*@
                        <div class="form-group col-md-8">
                            <div class="dropdown">
                                <label>What is your Marital Status?</label>
                                <select asp-for="MyMarital.Mstatus" id="MaritalStatusList" onChange="toggleStatus()" class="form-select">
                                    <option value="Single">Single</option>
                                    <option value="Married">Married</option>
                                    <option value="Widowed">Widowed</option>
                                    <option value="Separated">Separated</option>
                                    <option value="Divorced">Divorced</option>
                                </select>
                                <span asp-validation-for="MyMarital.Mstatus" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row" id="MaritalForm">
                            <div class="row">
                                <div class="form-group col-md-8">
                                    <label>What is your Spouse Full Legal Name?</label>
                                    <input type="text" asp-for="MyMarital.NAME" class="form-control" placeholder="Fiance Name">
                                    <span asp-validation-for="MyMarital.NAME" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-md-8">
                                    <label>What is your Gender?</label>
                                    <br />
                                    @Html.RadioButton("MyMarital.Gender", "M", "test")<span>M</span>
                                    <br />
                                    @Html.RadioButton("MyMarital.Gender", "F", "test")<span>F</span>
                                    <span asp-validation-for="MyMarital.Gender" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-8">
                                    <label>What is your Spouse NRIC Number</label>
                                    <input type="text" asp-for="MyMarital.NRIC" class="form-control" placeholder="Spouse NRIC">
                                    <span asp-validation-for="MyMarital.NRIC" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-8">
                                    <label>What is your Spouse Email?</label>
                                    <input type="text" asp-for="MyMarital.Email" class="form-control" placeholder="Spouse Email">
                                    <span asp-validation-for="MyMarital.Email" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-8">
                                    <label>What is your Spouse Mobile Number?</label>
                                    <input type="text" asp-for="MyMarital.PhoneNo"
                                           class="form-control" placeholder="Spouse Mobile Number">
                                    <span asp-validation-for="MyMarital.PhoneNo" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-8" style="margin:8px;">
                                    <p class="form-submit">
                                        <button asp-page-handler="AddFiance" class="blueButton" id="addBeneficiaryBtn">
                                            Add Fiance
                                        </button>
                                    </p>
                                    <br>
                                    <br>
                                </div>
                            </div>
                            <br>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                @*<button asp-page-handler="FianceBack" name="submit" type="submit" value="Back" class="BButton w-100 btn-lg" style="height:60px;">Back</button>*@
                                <button type="button" value="Back" onclick="location.href = 'WillForm';" class="BButton w-100 btn-lg" style="height:60px;">Back</button>

                            </div>
                            <br>
                            <div class="col-sm-6">
                                <button asp-page-handler="FianceNext"name="submit" type="submit" value="Next" class="btn w-100 btn-secondary btn-lg">Save & Next</button>


                            </div>
                        </div>
                    </form>
                    @*<div class="row">
                            <div class="col-lg-6">
                                <form action="WillManual.html">
                                    <button asp-page="WillForm" name="submit" type="submit" value="Back" class="BButton w-100 btn-lg" style="height:60px;">Back</button>
                                </form>

                            </div>
                            <br>
                            <div class="col-sm-6">
                                <form action="WillForm2.html" method="post">
                                    <button name="submit" type="submit" value="Next" class="btn w-100 btn-secondary btn-lg">Next</button>
                                </form>

                            </div>
                        </div>*@

                </div>

                <!-- Right hand side part of the website -->
                <div class="col-lg-6 mb-30">
                    <div class="contact-info ovpr-dark" style="background-image: url(images/about/pic-1.jpg);">
                        <div class="info-inner">
                            <h4 class="title mb-30">Your Marital Status</h4>
                            <text>
                                Information about your spouse makes the form easier to fill in later
                                on
                            </text>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    document.getElementById("MaritalForm").style.display = "none";
</script>
<script src="/js/willvar.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
