@page
@model afterlife_caretakers.Pages.willmaking.EditGiftModel
@{
    ViewData["Title"] = "Edit Gift ";
}
<!-- Inner Banner -->
<div class="banner-wraper">
    <div class="page-banner banner-lg contact-banner" style="background-image:url(images/banner/img1.jpg);">
        <div class="container">
            <div class="page-banner-entry text-center">
                <h1>Contact Us</h1>
                <!-- Breadcrumb row -->
                <nav aria-label="breadcrumb" class="breadcrumb-row">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="index.html"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg> Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Edit Asset</li>
                    </ul>
                </nav>
            </div>
        </div>
        <img class="pt-img1 animate-wave" src="images/shap/wave-blue.png" alt="">
        <img class="pt-img2 animate2" src="images/shap/circle-dots.png" alt="">
        <img class="pt-img3 animate-rotate" src="images/shap/plus-blue.png" alt="">
    </div>
    <!-- Breadcrumb row END -->
</div>
<!-- Inner Banner end -->
<!-- About us -->
<section class="">
    <div class="container">
        <div class="contact-wraper">
            <div class="row">
                <div class="col-lg-12 mb-30">
                    <form class="form-wraper contact-form" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <h5><u>Edit Gift</u></h5>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label>Gift Type:</label>
                                <input asp-for="MyGift.TYPE" class="form-control" readonly>
                                <span asp-validation-for="MyGift.TYPE" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <input type="hidden" asp-for="MyGift.Id" />
                                <input type="hidden" asp-for="MyGift.BeneID" />
                                <input type="hidden" asp-for="MyBeneficiary.Id" />
                                <label>Gift Name:</label>
                                <input asp-for="MyGift.gift_type" class="form-control" readonly>
                                <span asp-validation-for="MyGift.gift_type" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label>Amount:</label>
                                <input asp-for="MyGift.description" class="form-control" placeholder="Price">
                                <span asp-validation-for="MyGift.description" class="text-danger"></span>
                            </div>
                            @*<div class="form-group col-md-8" style="margin:8px;">
                                <label>Beneficiary Age:</label>
                                <input asp-for="MyGift.Address"  class="form-control"
                                       placeholder="Postal Address">
                                <span asp-validation-for="MyGift.Address" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label>Bank Name:</label>
                                <input asp-for="MyGift.BankName" class="form-control" placeholder="Price">
                                <span asp-validation-for="MyGift.BankName" class="text-danger"></span>
                                <label>Bank Account:</label>
                                <input asp-for="MyGift.BankAccount" class="form-control" placeholder="Price">
                                <span asp-validation-for="MyGift.BankAccount" class="text-danger"></span>
                            </div>*@
                            @*<div class="form-group col-md-6">
                                    <label>Witness Phone Number:</label>
                                    <input asp-for="MyBeneficiary.PhoneNo" class="form-control" placeholder="Price">
                                    <span asp-validation-for="MyBeneficiary.PhoneNo" class="text-danger"></span>
                                </div>*@
                            <div class="col-lg-12">
                                <button name="submit" type="submit" value="Submit" class="btn w-100 btn-secondary btn-lg">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
