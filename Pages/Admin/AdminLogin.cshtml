@page
@model afterlife_caretakers.Pages.Admin.AdminLoginModel
@{
}
<div class="section-area account-wraper2">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-5 col-lg-6 col-md-8">
                <div class="appointment-form form-wraper">
                    <div class="logo">
                        <img src="../images/logo.png" alt="">
                    </div>
                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active" id="formLogin" role="tabpanel" aria-labelledby="formLogin">
                            @Model.Msg
                            <form method="post">
                                <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                                <div class="form-group">

                                    <input type="text" asp-for="MyAdmin.email" class="form-control" placeholder="Email" />
                                </div>
                                <span class="text-danger" asp-validation-for="MyAdmin.email"></span>
                                <div class="form-group">

                                    <input type="password" asp-for="MyAdmin.password" class="form-control" placeholder="Password" />
                                </div>
                                <span class="text-danger" asp-validation-for="MyAdmin.password"></span>
                                <div class="form-group">
                                    <button type="submit" value="Login" class="btn mb-30 btn-lg btn-primary w-100">Login</button>
                                    <a href="#formForget" data-toggle="tab">Forgot Password</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

