@page
@model afterlife_caretakers.Pages.Admin.AccountDetailsModel
@{
}
<div class="page-content bg-white">

    <!-- Inner Banner -->
    <div class="banner-wraper">
        <div class="page-banner banner-lg contact-banner" style="background-image:url(images/banner/img1.jpg);">
            <div class="container">
                <div class="page-banner-entry text-center">
                    <h1>Edit Account Details</h1>

                    <!-- Breadcrumb row -->
                    <nav aria-label="breadcrumb" class="breadcrumb-row">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="index.html"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg> Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Edit Account</li>
                        </ul>
                    </nav>
                </div>
            </div>
            <img class="pt-img1 animate-wave" src="images/shap/wave-blue.png" alt="">
            <img class="pt-img2 animate2" src="images/shap/circle-dots.png" alt="">
            <img class="pt-img3 animate-rotate" src="images/shap/plus-blue.png" alt="">
        </div>
        <!-- Breadcrumb row END -->
    </div>
    <!-- Inner Banner end -->
    <!-- About us -->
    <section class="">
        <div class="container">
            <div class="contact-wraper">
                <div class="row justify-content-center">
                    <div class="col-lg-6 mb-30">
                        @if (TempData["AlertMessage"] != null)
                        {
                            <div class="alert alert-success">
                                <strong>
                                    Success!
                                </strong> @TempData["AlertMessage"]
                            </div>
                        }
                        <form class="form-wraper contact-form ajax-form" method="post">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <input type="hidden" asp-for="MyAdmin.Id" />
                            <div class="row">
                                <div class="form-group col-md-12">
                                    <label asp-for="MyAdmin.name" class="control-label"></label>
                                    <input asp-for="MyAdmin.name" class="form-control" />
                                    <span asp-validation-for="MyAdmin.name" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="MyAdmin.gender" class="control-label"></label>
                                    <input asp-for="MyAdmin.gender" readonly class="form-control" />
                                    <span asp-validation-for="MyAdmin.gender" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="MyAdmin.email" class="control-label"></label>
                                    <input asp-for="MyAdmin.email" readonly class="form-control" />
                                    <span asp-validation-for="MyAdmin.email" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-12">
                                    <label asp-for="MyAdmin.office_num" class="control-label"></label>
                                    <input asp-for="MyAdmin.office_num" class="form-control" />
                                    <span asp-validation-for="MyAdmin.office_num" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-12">
                                    <label asp-for="MyAdmin.specialisation" class="control-label"></label>
                                    <input asp-for="MyAdmin.specialisation" readonly class="form-control" />
                                    <span asp-validation-for="MyAdmin.specialisation" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-12">
                                    <label asp-for="MyAdmin.clinic_address" class="control-label"></label>
                                    <input asp-for="MyAdmin.clinic_address" class="form-control" />
                                    <span asp-validation-for="MyAdmin.clinic_address" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label class="col-sm-2 col-form-label"> Status:</label>
                                    @Html.DropDownList("MyAdmin.status", new SelectList(Enum.GetValues(typeof(Models.AdminStatus))), "--Select an option--")
                                    <span asp-validation-for="MyAdmin.status" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="MyAdmin.admin_role" class="control-label"></label>
                                    <input asp-for="MyAdmin.admin_role" readonly class="form-control" />
                                    <span asp-validation-for="MyAdmin.admin_role" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="MyAdmin.password" class="control-label"></label>
                                    <input asp-for="MyAdmin.password" readonly class="form-control" />
                                    <span asp-validation-for="MyAdmin.password" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="MyAdmin.password" class="control-label"></label>
                                    <input asp-for="MyAdmin.password" readonly class="form-control" />
                                    <span asp-validation-for="MyAdmin.password" class="text-danger"></span>
                                </div>
                                
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <input type="submit" value="Save" class="btn w-100 btn-secondary btn-lg" />&nbsp;
                                        @*<a asp-page="./Index" class="btn btn-primary">Back to List</a>*@
                                    </div>
                                </div>
                            </div>
</form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
