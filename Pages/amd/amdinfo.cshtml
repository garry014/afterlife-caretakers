<!-- About us -->
<section class="">
    <div class="container" style="width:70%">
        <div class="contact-wraper">
            <div class="row ">
                <div class="col-lg-12 mb-30">
                    <form class="form-wraper contact-form ajax-form" action="script/contact.php">
                        <div class="ajax-message">
                            <div class="stepper-wrapper">
                                <div class="stepper-item active">
                                    <div class="step-counter">1</div>
                                    <div class="step-name">Your Info</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">2</div>
                                    <div class="step-name">Witness<br></div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">3</div>
                                    <div class="step-name">View Details</div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">4</div>
                                    <div class="step-name">Payment<br></div>
                                </div>
                                <div class="stepper-item">
                                    <div class="step-counter">5</div>
                                    <div class="step-name">Download</div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div class="col-lg-12 mb-30">
                        <form class="form-wraper contact-form" method="post">
                            <div class="row">
                                <h3 style="text-align:center; padding-bottom:20px; margin-top:-20px"><br />Personal Details</h3>
                                <div class="form-group col-md-6">
                                    <input name="name" type="text" required class="form-control" placeholder="Nina Tan" readonly>
                                </div>
                                <div class="form-group col-md-6">
                                    <input name="nric" type="text" required class="form-control" placeholder="S1234567A" readonly>
                                </div>
                                <div class="form-group col-md-6">
                                    <label style="font-size:16px">Gender</label><br />
                                    <div style="margin-top: -10px; margin-bottom: -30px">
                                        <input class="form-check-input" type="radio" id="F" name="gender" value="F" checked>
                                        <label style="font-size:16px">Female</label>
                                        &emsp;&emsp;&emsp;
                                        <input class="form-check-input" type="radio" id="M" name="gender" value="M" disabled>
                                        <label style="font-size:16px">Male</label>
                                    </div>

                                </div>
                                <div class="form-group col-md-6">
                                    <input name="date" type="text" required class="form-control" placeholder="08/15/1950" readonly>
                                </div>
                                <div class="form-group col-md-8">
                                    <input name="address" type="text" required class="form-control" placeholder="Yishun Ave 2, Blk 70" readonly>
                                </div>
                                <div class="form-group col-md-4">
                                    <input name="postal" type="text" required class="form-control" placeholder="Singapore 769098" readonly>
                                </div>
                                <div class="form-group col-md-6">
                                    <input name="homeno" type="text" required class="form-control" placeholder="65985462" readonly>
                                </div>
                                <div class="form-group col-md-6">
                                    <input name="officeno" type="text" required class="form-control" placeholder="63663248" readonly>
                                </div>
                                <div class="text-center">
                                    @*<button id="" type="submit" class="btn btn-secondary" style="padding-left:80px; padding-right:80px; font-size:15px" onclick="location.href = 'amdwitness';">Next</button>*@
                                    <a href="../amd/amdwitness" class="btn btn-secondary" style="padding-left:80px; padding-right:80px; font-size:15px">Next</a>

                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
</section>

<br />
<br />
<br />
<br />
