@page
@model afterlife_caretakers.Pages.lastmsg.ViewVideoModel
@{
    ViewData["Title"] = "View - Last message";
}
<div class="banner-wraper">
    <div class="page-banner banner-lg contact-banner" style="background-image:url(/images/banner/img1.jpg);">
        <div class="container">
            <div class="page-banner-entry text-center">
                <h1>View Last Message</h1>
                <!-- Breadcrumb row -->
                <nav aria-label="breadcrumb" class="breadcrumb-row">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="index.html"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg> Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Last Message</li>
                    </ul>
                </nav>
            </div>
        </div>

    </div>
    <!-- Breadcrumb row END -->
</div>
<!-- Inner Banner end -->
<!-- About us -->
<section class="">
    <div class="container">
        <div class="contact-wraper">
            <div class="row">
                @if (@Model.ErrorMsg == null)
                {
                    <div class="col-lg-12 mb-30">
                        <center>
                            <h5>Video</h5>

                            <video id="recorded" width="800" style="display: block; margin: 0 auto;" controls>
                                <source src="/UploadedFiles/@Model.Video.videoLink" type="video/webm">
                                Your browser does not support HTML video.
                            </video>

                        </center>
                    </div>
                    <div class="col-lg-12 mb-30">
                        <center>
                            @if (@Model.Video.writtenMemo != null)
                            {
                                <span>Written Memo: </span>
                                <span>@Model.Video.writtenMemo</span>
                            }
                        </center>
                    </div>
                }
                @if (@Model.ErrorMsg != null) { 
                    <div class="col-lg-12 mb-30">
                        @Model.ErrorMsg
                    </div>
                }
            </div>
        </div>
</section>